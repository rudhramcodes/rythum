NODE_ENV=development
PORT=4000
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=rythum_development
WEB_ORIGINS=http://localhost:5173
# Set only to the IP/subnet of your trusted reverse proxy, e.g. loopback for local Nginx.
TRUST_PROXY=

# Saved inquiries work while email is disabled. Pending jobs wait for the worker.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_REPLY_TO=
# Comma-separated approved staff recipients; configured before taking submissions.
TEAM_EMAILS=

ADMIN_EMAIL=notyourshastri@gmail.com
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
